{
  "manifest_version": 3,
  "name": "ScrollMark",
  "version": "1.1.1",
  "description": "Bookmark exact positions on webpages and return to them later.",
  "author": "wierucha",
  "homepage_url": "https://github.com/wierucha",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "commands": {
    "save-position": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current scroll position"
    }
  },
  "action": {
    "default_title": "ScrollMark",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "scrollmark@wierucha",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}